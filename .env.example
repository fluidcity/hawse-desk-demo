# HAWSE paper desk — environment variables. Copy to .env (gitignored) and fill what you have.
# Every secret is read SERVER-SIDE only and never sent to the browser.
# Nothing here enables live trading: this build is paper-only by construction.

# --- server ---
HOST=127.0.0.1            # bind address (no auth on the API; keep it local)
PORT=8787
TRADING_MODE=paper        # must be "paper"; anything else makes the server refuse to start
PAPER_START_EQUITY=10000
# Strategy armed on/off survives restarts in data/state/armed.json (default). Set ARMED_STATE_FILE= (empty) to disable, or a path to move it.
# ARMED_STATE_FILE=

# --- portfolio risk gate ---
RISK_DAILY_LOSS_PCT=3     # halt new risk when equity <= day-start * (1 - 3%)  (clears next UTC day)
RISK_MAX_DRAWDOWN_PCT=10  # latched breaker when equity <= peak * (1 - 10%)  (manual reset)

# --- Strategy 1: perp funding arb (public endpoints, no keys) ---
FUNDING_SYMBOLS=BTC,ETH,SOL,XRP,DOGE,BNB,ARB,AVAX
FUNDING_POLL_MS=30000
FUNDING_HOLD_HOURS=24     # horizon used to judge whether the spread beats costs
FUNDING_MIN_NET_BPS=8     # required net edge (bps of notional) over the hold horizon
FUNDING_PERSIST_PRINTS=3  # v2: spread positive for the last N observations
FUNDING_FLIP_PRINTS=2     # v2: exit after N consecutive negative observations
FUNDING_OBS_SEC=900       # v2: one funding observation per venue per this many seconds (min 30)
FUNDING_MIN_APR=10        # v2: net APR floor (% on 2x notional)
FUNDING_MAX_ENTRY_BASIS_BPS=15
FUNDING_BASIS_STOP_BPS=40
FUNDING_USE_PREDICTED=true # v2: Hyperliquid predictedFundings forecast gate (fails closed if missing)
FUNDING_HL_TOP_OI=20      # v2: add top-N Hyperliquid perps by open interest (0 = configured symbols only)
FUNDING_SHADOW_V1=true    # v2: naive v1 control shadow (never booked)
CARRY_ENABLED=true        # v2: same-venue long spot / short perp carry
CARRY_MIN_NET_BPS=15
CARRY_HOLD_HOURS=72
SPOT_POLL_MS=30000        # public spot REST poll for carry (OKX, Binance, Bybit)

# --- Strategy 2: whale / large-transaction monitor ---
# Solana (Helius → HAWSE webhook inbox). Credit model (helius.dev, checked 2026-10-29): webhook event = 1 credit per
# delivered tx, webhook create/edit/delete = 100, free plan = 1M credits/month. Polling the inbox costs NO Helius credits.
# OFF BY DEFAULT: unless WHALES_ENABLED=true, Solana runs in labelled DEMO/MOCK mode and NO Helius/inbox calls are made.
# Enabled but HAWSE_WEBHOOK_URL / HAWSE_READ_TOKEN missing -> labelled MOCK "inbox not configured".
# All four secrets below are read server-side only: never logged, never sent to the browser, never commit real values.
WHALES_ENABLED=false
HAWSE_WEBHOOK_URL=        # inbox base URL (Cloudflare Worker), e.g. https://<name>.<account>.workers.dev; Helius delivers to <it>/helius
HAWSE_READ_TOKEN=         # desk -> GET /events with "Authorization: Bearer <token>"
HELIUS_WEBHOOK_AUTH=      # raw Authorization value (NO "Bearer") Helius sends to the inbox; used by scripts/helius-webhook.js
HELIUS_API_KEY=           # used only by scripts/helius-webhook.js and the near-cap auto-pause; never sent to the browser
# HELIUS_MODE=            # inbox | mock | off. Default when enabled: inbox
# INBOX_POLL_SEC=30       # poll interval, clamped 15-60; loops immediately while more=true
# INBOX_LIMIT=100         # events per /events page (1-200)
# INBOX_STATE_FILE=data/inbox-state.json  # persisted cursor + recent signatures + gaps (runtime state, gitignored); '' = memory only
# INBOX_MAX_SIGNAL_AGE_SEC=600  # older deliveries (backlog after downtime) are shown but never trigger strategies
# HELIUS_WEBHOOK_ADDRESSES= # accounts the webhook watches (else HELIUS_WATCH_ADDRESSES, else FOLLOW_WALLETS_SOL, else the
#                           # verified proposed list in server/feeds/helius-watch.js). Busy AMM pools are refused
# HELIUS_WEBHOOK_TX_TYPES=SWAP,TRANSFER
# HELIUS_WEBHOOKS_API=https://api-mainnet.helius-rpc.com/v0/webhooks  # override if Helius moves the endpoint
# HELIUS_CREDIT_BUDGET=300000       # HARD monthly cap (delivered webhook events are counted)
# HELIUS_DAILY_CREDIT_BUDGET=30000  # HARD daily cap (UTC day), shown as a counter in Data Sources
# HELIUS_PAUSE_AT_PCT=90            # auto-pause at this % of the daily/monthly cap: events are ignored
# HELIUS_AUTO_PAUSE_WEBHOOK=true    # near the cap also PATCH our webhook (matched by <HAWSE_WEBHOOK_URL>/helius) to active:false:
#                                   # 100 credits, needs HELIUS_API_KEY. Helius bills every delivery, so this is the only way to stop spend.
#                                   # Resume manually: node scripts/helius-webhook.js resume --apply
HELIUS_WATCH_ADDRESSES=   # comma list of whale accounts the desk acts on (else FOLLOW_WALLETS_SOL, else the proposed list)
# CREDITS_FILE=data/credits.json  # local credit counters (gitignored); '' = memory only
# Wallet follow v2 (H3). Hyperliquid fills are public (no key, no credits). Solana uses the Helius whale feed above (off by default).
FOLLOW_ENABLED=true
FOLLOW_WALLETS_SOL=       # Solana fee-payer wallets (also the Helius watch list when HELIUS_WATCH_ADDRESSES is empty)
FOLLOW_WALLETS_HL=        # comma list of 0x addresses (dated "now"); scripts/score-wallets.js --write fills data/watchlist.json
# FOLLOW_WATCHLIST_FILE=data/watchlist.json
# FOLLOW_SCORE_FILE=data/follow/scoreboard.json
FOLLOW_MIN_USD_HL=50000
FOLLOW_MIN_USD_SOL=25000
FOLLOW_DELAY_SEC_HL=20    # simulated copy latency before entry
FOLLOW_DELAY_SEC_SOL=10
FOLLOW_MAX_CHASE_PCT=0.5
FOLLOW_TP=0.02
FOLLOW_SL=0.01
FOLLOW_MAX_HOLD_H_HL=6
FOLLOW_MAX_HOLD_H_SOL=2
FOLLOW_HL_POLL_MS=30000   # each wallet polled once per this period (min 10000)
FOLLOW_CONTROLS=true      # random-direction + buy-and-hold controls, SIM-booked
# --- Mempool lab (H4): measurement/simulation only, never signs or submits ---
MEMPOOL_ENABLED=false     # off = no socket, no RPC calls. On = public publicnode WS/HTTP (or ALCHEMY_API_KEY if set)
# MEMPOOL_WS_URL=         # override pending-tx websocket (must support eth_subscribe)
# MEMPOOL_RPC_URL=        # override read-only JSON-RPC (eth_call / blocks / receipts / nonce only)
MEMPOOL_MIN_USD=25000     # only simulate pending swaps at least this large
MEV_BID_SHARE=0.9         # share of gross assumed paid to the builder in the "realistic" figure (0..1)
MEV_GAS_UNITS_SANDWICH=360000
MEV_GAS_UNITS_BACKRUN=180000
# MEMPOOL_EVENTS_FILE=data/mev/events.json
# MEMPOOL_DUNE_FILE=data/mev/dune-sandwiched.json   # written by scripts/mev-import-dune.js from a CSV you export

WHALE_MIN_USD=250000      # minimum USD size for a "whale" transaction
# EVM chains (Ethereum, Base, Arbitrum). Priority: explicit URL > Alchemy > Infura > public RPC fallback > MOCK
EVM_CHAINS=ethereum,base,arbitrum
EVM_RPC_URL=              # alias for EVM_RPC_URL_ETHEREUM
EVM_RPC_URL_ETHEREUM=
EVM_RPC_URL_BASE=
EVM_RPC_URL_ARBITRUM=
ALCHEMY_API_KEY=
INFURA_API_KEY=
EVM_PUBLIC_RPC_FALLBACK=true   # use free public RPCs (publicnode) when no key is set; false => MOCK

# --- Strategy 3: 1% compounding (public candles, no keys) ---
ONEPCT_SYMBOLS=BTC,ETH,SOL
ONEPCT_TARGET_NET_PCT=1
ONEPCT_MIN_SCORE=80

# --- Strategy 4: DEX price-gap scanner (public quote APIs, no keys) ---
JUPITER_API_BASE=https://api.jup.ag   # lite-api.jup.ag is being retired
JUPITER_API_KEY=          # optional free key (developers.jup.ag), sent server-side as x-api-key: 1 rps instead of keyless 0.5 rps
GAP_NOTIONAL_USD=1000
GAP_P_SUCCESS=0.35        # assumed probability an atomic arb lands (searcher competition)
GAP_SOL_TIP_LAMPORTS=100000
GAP_SOL_PRIORITY_MICROLAMPORTS=50000
GAP_EVM_GAS_PER_SWAP=180000   # gas units per swap leg
GAP_EVM_POOL_FEE_BPS=5        # assumed pool fee per leg on indicative mid-price gaps
GAP_MIN_EV_USD=0.5            # minimum expected value after costs to attempt
# GAP_SOL_POLL_MS=30000  GAP_EVM_POLL_MS=60000

# --- Strategy 5: Tradovate CME micros (demo API) ---
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_CID=
TRADOVATE_SECRET=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_SYMBOLS=        # optional override, MES first then MNQ, e.g. MESZ6,MNQZ6 (default: computed front month)
TRADOVATE_SIM_BAR_MS=1500 # simulated fallback: one 1-minute bar every N ms (accelerated replay)
ORB_MINUTES=15            # opening range length (minutes after 09:30 ET)
ORB_TARGET_R=1.5
ORB_FEE_PER_SIDE=0.72     # USD per contract per side (commission + exchange + NFA, approx.)
ORB_MAX_RISK_PCT=8        # max % of the strategy sleeve risked per trade (skip if 1 contract exceeds it)
ORB_MIN_WIDTH_PCT=0.1
ORB_MAX_WIDTH_PCT=0.8

# ---- Websocket data path (Stage 6) ----
# Public exchange websockets (Binance USD-M /public + /market, Bybit, OKX, Hyperliquid, Binance/Bybit/OKX spot). No keys.
# REST polling keeps running as the labelled fallback.
WS_ENABLED=true
WS_SPOT_SYMBOLS=BTC,ETH,SOL
# Optional EVM websocket endpoints for newHeads push triggers (e.g. a QuickNode wss URL). Fallback: Alchemy/Infura wss,
# then publicnode wss when EVM_PUBLIC_RPC_FALLBACK=true.
EVM_WS_URL_ETHEREUM=
EVM_WS_URL_BASE=
EVM_WS_URL_ARBITRUM=

# ---- Provider registry extras ----
# Pyth Hermes requires an API key since 2026-08-26 (Authorization: Bearer). Without it the oracle cross-check is idle.
PYTH_API_KEY=
PYTH_HERMES_URL=
# Premium vendors: placeholders only (no adapter yet). Setting a key flips status to "not implemented".
KAIKO_API_KEY=
AMBERDATA_API_KEY=
COINAPI_KEY=
TARDIS_API_KEY=

# --- Crypto perps (paper) ---
# PERP_SYMBOLS=BTC,ETH,SOL
# PERP_MOM_BAR=5m            # OKX bar: 1m 5m 15m 1H 4H
# PERP_MOM_LOOKBACK=20
# PERP_MOM_SL_ATR=1.5
# PERP_MOM_TP_ATR=3
# PERP_MOM_RISK_PCT=0.01     # fraction of sleeve risked per trade
# PERP_MOM_SIZE_PCT=0.5      # max notional as fraction of sleeve
# PERP_MOM_MAX_HOLD_H=6
# BASIS_MIN_NET_BPS=5
# BASIS_EXIT_BPS=2
# BASIS_HOLD_H=24            # expected hold used to value funding at entry
# BASIS_MAX_HOLD_H=72
# BASIS_SIZE_PCT=0.45
# BASIS_MAX_POSITIONS=2

# --- Sports betting (PAPER ONLY; real-money placement is a disabled stub) ---
# The Odds API key (https://the-odds-api.com). Server-side only; never sent to the browser.
# Empty = labeled MOCK odds market, all bets SIMULATED.
# Credits (the-odds-api.com v4 docs, checked 2026-10-29): /odds = markets x regions (10 bookmakers = 1 region);
# /events and /sports are free; /scores = 2 with daysFrom. Free plan = 500 credits/month. Defaults below ≈ 345/month.
ODDS_API_KEY=
# ODDS_API_KEY_PAID=         # OPTIONAL later swap. Never used automatically: only read when ODDS_USE_PAID_KEY=true
# ODDS_USE_PAID_KEY=false    # if the free key runs out, polling STOPS and the desk shows QUOTA EXHAUSTED (no fallback)
# ODDS_PLAN_CREDITS=500      # your plan's monthly credits (display + warning); e.g. 20000 on a paid key
# ODDS_MONTHLY_BUDGET=450    # hard monthly cap this app may spend (also bounded by x-requests-remaining)
# ODDS_SPORTS=basketball_nba
# ODDS_MARKETS=h2h           # each extra market multiplies the cost
# ODDS_BOOKMAKERS=pinnacle,draftkings,fanduel,betmgm,betrivers,espnbet,bovada,betonlineag,lowvig,mybookieag  # ≤10 = 1 region; set empty to use ODDS_REGIONS
# ODDS_REGIONS=us            # only used when ODDS_BOOKMAKERS is empty
# ODDS_SCHEDULE=snapshots    # or 'interval' (old fixed polling; still budget-guarded)
# BET_SNAPSHOTS_MIN=360,60,10  # minutes before each start to snapshot odds; the smallest is the closing snapshot (CLV)
# ODDS_SNAPSHOT_MERGE_MIN=15 # merge snapshot times this close into one call
# ODDS_EVENTS_REFRESH_MIN=180 # free /events slate refresh
# ODDS_HORIZON_HOURS=36
# ODDS_CLOSING_ONLY_BELOW_PCT=15  # below this % of credits left, only closing snapshots run
# ODDS_SCORES_AFTER_MIN=200  # check scores this long after a start ...
# ODDS_SCORES_MIN_GAP_H=12   # ... at most once per this many hours per sport
# ODDS_CACHE_TTL_SEC=900     # on-disk response cache so restarts never re-spend
# ODDS_CACHE_FILE=data/odds-cache.json
# ODDS_POLL_SEC=900          # interval mode only
# ODDS_SCORES_POLL_SEC=1800  # interval mode only
# BET_MIN_EDGE_PCT=2
# BET_MIN_BOOKS=3
# BET_MAX_ODDS_DEC=6
# BET_FAIR_METHOD=multiplicative   # or power
# BET_KELLY_FRACTION=0.25
# BET_MAX_STAKE_PCT=2        # % of sleeve bankroll per bet
# BET_MAX_EVENT_PCT=4        # % per event
# BET_MAX_OPEN_PCT=25        # % total open exposure
# BET_MIN_STAKE_USD=5
# BET_MIN_MINUTES_TO_START=20      # H1 time-to-start gate (real odds)
# BET_MAX_HOURS_TO_START=36
# BET_MOCK_MIN_MINUTES_TO_START=2  # MOCK feed only (its schedule is accelerated)
# H1: Pinnacle-anchored +EV + CLV scoreboard
# BET_ANCHOR=pinnacle              # or consensus (old behaviour: no-vig consensus of the other books)
# BET_ANCHOR_BOOK=pinnacle
# BET_ANCHOR_METHOD=power          # or multiplicative
# BET_MIN_EDGE_SPREADS_PCT=2.5     # BET_MIN_EDGE_PCT (2) applies to moneylines
# BET_MIN_EDGE_LONGSHOT_PCT=4
# BET_LONGSHOT_DEC=4
# BET_MAX_HOLD_PCT=5               # skip when the anchor's own margin is higher
# BET_MAX_PRICE_AGE_SEC=600        # per-market last_update age, both prices
# BET_MAX_AGE_GAP_SEC=300          # soft vs anchor update gap
# BET_CLOSE_WITHIN_MIN=10          # closing line = last anchor snapshot within N min of start
# BET_MIN_POINT_EDGE=1
# BET_POINT_VALUE_PCT=2.5    # ASSUMED win-prob pp per point of spread edge
# BET_MIN_ARB_PCT=0.5
# BET_ARB_STAKE_PCT=6
# BET_MIDDLE_MAX_COST_PCT=3
# ODDS_MOCK_EVENTS=8
# ODDS_MOCK_TICK_MS=5000
# ODDS_MOCK_GAME_MIN=4

# --- Betting rules desk (rules -> signals -> printable slips; nothing is ever placed) ---
# BET_RULES_FILE=data/betting/rules.json   # '' = in-memory only; data/ is gitignored
# BET_SCAN_MS=5000
# BET_MAX_SIGNALS=300
# BET_SLIP_BANKROLL_USD=1000   # paper bankroll used only for the stake idea on a slip
# BET_STATS_MOCK=true          # no real stats provider is wired; stats-based signals are SIM

# --- Kalshi / Polymarket direct links: order placement is DISABLED and has no code path. ---
# Exception (H7): KALSHI_API_KEY_ID + KALSHI_PRIVATE_KEY_PATH (or _PEM) are read server-side ONLY when KALSHI_WS=true,
# and ONLY to sign the market-data WebSocket handshake (see the H7 block below and docs/kalshi-api-key.md).
# Use a READ-ONLY key. Never commit values; keep the key file outside the repo (e.g. /home/box/secrets, chmod 600).
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=
# KALSHI_ENV=demo
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_FUNDER_ADDRESS=
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=

# Binance spot REST host (default data-api.binance.vision, public market data only)
BINANCE_SPOT_REST=

# --- H6 market-data recorder (record only; public endpoints; files under data/recorder, gitignored) ---
RECORDER_ENABLED=
RECORDER_DIR=
# Disk cap for data/recorder in GiB, default 12 (≈ 8 weeks at the measured ~210 MiB/day gzipped). A cap set live in
# the Storage panel is saved to data/runtime/recorder-cap.json (gitignored) and wins over this value on restart.
RECORDER_CAP_GB=
RECORDER_MAX_FILE_MB=
RECORDER_ROTATE_MIN=
RECORDER_KALSHI=
KALSHI_PUBLIC_BASE=
RECORDER_KALSHI_SERIES=
RECORDER_KALSHI_EXTRA_SERIES=
RECORDER_KALSHI_EXTRA_TOP=
RECORDER_KALSHI_BOOK_MS=
RECORDER_KALSHI_TRADES_MS=
RECORDER_KALSHI_MAX_RPS=
RECORDER_POLYMARKET=
RECORDER_POLY_ASSETS=
RECORDER_POLY_TOP=
RECORDER_POLY_BOOK_MS=
RECORDER_REF=
# default coinbase,kraken,bitstamp,gemini,cryptocom,bullish (6 of 7 BRTI constituents; LMAX has no free feed)
RECORDER_REF_VENUES=
RECORDER_REF_ASSETS=
RECORDER_ODDS=

# --- H7 optional Kalshi WebSocket market data (off by default; needs a READ-ONLY Kalshi key; see docs/kalshi-api-key.md) ---
# Subscribes orderbook_delta + trade for the live 15m markets (rows: kalshi.ws.book / kalshi.ws.trade). The REST poller keeps running.
KALSHI_WS=
# default wss://api.elections.kalshi.com/trade-api/ws/v2 (any *.kalshi.com / *.kalshi.co wss URL on /trade-api/ws/v2)
KALSHI_WS_URL=
# Alternative to KALSHI_PRIVATE_KEY_PATH: the PEM inline with literal \n escapes. Prefer the file path.
# KALSHI_PRIVATE_KEY_PEM=
# true = also subscribe cfbenchmarks_value (the CF Benchmarks RTI values Kalshi settles on, ~1/s) -> kalshi.ws.cf
KALSHI_WS_CF_INDEX=
# default BRTI,ETHUSD_RTI,SOLUSD_RTI,XRPUSD_RTI
KALSHI_WS_CF_INDEX_IDS=
# true = also stream the extra (daily/sports) series tracked by the REST recorder
KALSHI_WS_EXTRA=

# --- H7 Storage panel (fill bars for disk/memory consumers + live recorder-cap control; POST is localhost/same-origin only) ---
STORAGE_PANEL=
STORAGE_DATA_DIR=
# optional absolute path of the desk's stdout log so it gets its own bar (e.g. the nohup target)
DESK_LOG_FILE=
RECORDER_CAP_MIN_GB=
RECORDER_CAP_MAX_GB=
STORAGE_WARN_PCT=
STORAGE_CRIT_PCT=
# false = ignore data/runtime/recorder-cap.json at startup
RECORDER_RUNTIME_CAP=

# --- H6 Part C: Kalshi H2 frozen forward PAPER test (paper ledger under data/paper/kalshi-h2, gitignored) ---
KALSHI_H2_PAPER=
KALSHI_H2_DIR=
# false = turn off the v2 arm / the v3 sizing arm (both paper only; v3 needs v2)
KALSHI_H2_V2=
KALSHI_H2_V3=

# --- Cloudflare always-on recorder (H7 Stage L, docs/cloudflare-recorder.md) ---
# Read-only pull of the hawse-recorder Worker. Keep real values in /home/box/secrets/hawse-cf-recorder.env (mode 600),
# never here. Both missing = the panel shows "not configured". CF_RECORDER=false turns it off.
CF_RECORDER=
CF_RECORDER_URL=
CF_RECORDER_READ_TOKEN=
CF_RECORDER_STATUS_MS=
CF_RECORDER_SYNC=
CF_RECORDER_SYNC_MS=
CF_RECORDER_STALE_MS=

# ---- Remote-view auth proxy (scripts/auth-proxy.js, Stage Q) ----
# Read by the proxy process only (not the desk). Put the token in a secrets file, never on the command line.
HAWSE_ACCESS_TOKEN=            # required, >= 24 chars, no whitespace; proxy refuses to start otherwise
HAWSE_PROXY_PORT=              # default 8789
HAWSE_PROXY_HOST=              # default 127.0.0.1 (use an HTTPS tunnel for remote access)
HAWSE_PROXY_UPSTREAM=          # default http://127.0.0.1:8788 (loopback http only)
HAWSE_PROXY_ALLOW_POST=        # default empty = read-only; subset of: halt,resume,reset-breaker,risk,arm
HAWSE_PROXY_INSECURE_COOKIE=   # 1 = drop the Secure cookie flag (plain-http testing only)
