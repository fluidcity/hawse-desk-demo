# HAWSE paper desk — environment variables. Copy to .env (gitignored) and fill what you have.
# Every secret is read SERVER-SIDE only and never sent to the browser.
# Nothing here enables live trading: this build is paper-only by construction.

# --- server ---
HOST=127.0.0.1            # bind address (no auth on the API; keep it local)
PORT=8787
TRADING_MODE=paper        # must be "paper"; anything else makes the server refuse to start
PAPER_START_EQUITY=10000

# --- portfolio risk gate ---
RISK_DAILY_LOSS_PCT=3     # halt new risk when equity <= day-start * (1 - 3%)  (clears next UTC day)
RISK_MAX_DRAWDOWN_PCT=10  # latched breaker when equity <= peak * (1 - 10%)  (manual reset)

# --- Strategy 1: perp funding arb (public endpoints, no keys) ---
FUNDING_SYMBOLS=BTC,ETH,SOL,XRP,DOGE,BNB,ARB,AVAX
FUNDING_POLL_MS=30000
FUNDING_HOLD_HOURS=24     # horizon used to judge whether the spread beats costs
FUNDING_MIN_NET_BPS=8     # required net edge (bps of notional) over the hold horizon

# --- Strategy 2: whale / large-transaction monitor ---
HELIUS_API_KEY=           # Solana (Helius enhanced transactions). Empty => Solana runs in labeled MOCK mode
HELIUS_WATCH_ADDRESSES=   # optional comma list of Solana accounts/pools to watch (defaults: major SOL/USDC pools)
WHALE_MIN_USD=250000      # minimum USD size for a "whale" transaction
# EVM chains (Ethereum, Base, Arbitrum). Priority: explicit URL > Alchemy > Infura > public RPC fallback > MOCK
EVM_CHAINS=ethereum,base,arbitrum
EVM_RPC_URL=              # alias for EVM_RPC_URL_ETHEREUM
EVM_RPC_URL_ETHEREUM=
EVM_RPC_URL_BASE=
EVM_RPC_URL_ARBITRUM=
ALCHEMY_API_KEY=
INFURA_API_KEY=
EVM_PUBLIC_RPC_FALLBACK=true   # use free public RPCs (publicnode) when no key is set; false => MOCK

# --- Strategy 3: 1% compounding (public candles, no keys) ---
ONEPCT_SYMBOLS=BTC,ETH,SOL
ONEPCT_TARGET_NET_PCT=1
ONEPCT_MIN_SCORE=80

# --- Strategy 4: DEX price-gap scanner (public quote APIs, no keys) ---
JUPITER_API_BASE=https://lite-api.jup.ag
GAP_NOTIONAL_USD=1000
GAP_P_SUCCESS=0.35        # assumed probability an atomic arb lands (searcher competition)
GAP_SOL_TIP_LAMPORTS=100000
GAP_SOL_PRIORITY_MICROLAMPORTS=50000

# --- Strategy 5: Tradovate CME micros (demo API) ---
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_CID=
TRADOVATE_SECRET=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_SYMBOLS=        # optional override, e.g. MESZ6,MNQZ6 (default: computed front month)
